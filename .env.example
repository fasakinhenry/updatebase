# ---------------------------------------------------------------------------
# updatebase frontend
# copy to .env.local and fill in. every var here is validated at boot by
# src/lib/env.ts, so a typo fails loudly instead of turning into undefined.
# ---------------------------------------------------------------------------

# base url of the updatebase api
VITE_API_URL=http://localhost:4000

# public url this site is served from. used for canonicals, og tags and sitemap.
VITE_SITE_URL=http://localhost:5173

# google oauth web client id, from console.cloud.google.com -> credentials
VITE_GOOGLE_CLIENT_ID=

# dicebear avatar api base
VITE_DICEBEAR_URL=https://api.dicebear.com/9.x

# "true" turns on analytics once the visitor has consented
VITE_ENABLE_ANALYTICS=false
