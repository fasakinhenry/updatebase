{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist",
    "dev-dist",
    "node_modules"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/incompatible-library": "off"
  }
}
